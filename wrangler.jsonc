{
  // Static site on Cloudflare Workers (assets only, no code). Connect this repo under Workers & Pages → Create →
  // Import a repository; Cloudflare then deploys on every push to main (same setup as alphadevices-site).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "davidsteinberg",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash" }
}
