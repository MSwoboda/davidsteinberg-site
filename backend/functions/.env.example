# Copy to .env (not committed). Passwords live in Secret Manager (GMAIL_APP_PASSWORD, SMTP_PASSWORD), never here.
# Mail transport: fill the SMTP_* lines to send through LuxSci (or any SMTP provider); leave SMTP_HOST empty to send through Gmail.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
# Gmail fallback (used only when SMTP_HOST is empty)
GMAIL_USER=michswo@gmail.com
# Where the notifications go (comma-separated for several); defaults to the sending address
NOTIFY_TO=michswo@gmail.com
# Who may open the admin dashboard (comma-separated Google accounts)
STAFF_EMAILS=michswo@gmail.com
# Any long random string; salts the daily visitor hash in the traffic counter
TRAFFIC_SALT=replace-with-a-long-random-string
# full = the whole request in the notification email (default); ping = name + dashboard link only; none = no email at all
NOTIFY_DETAIL=full
# LuxSci SecureForm from the backend (needs a fixed outbound address; normally empty — the page posts to LuxSci itself, see js/config.js secureFormId)
SECUREFORM_ID=
